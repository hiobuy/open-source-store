# Web Worker (storefront). Copy to .env; it is ignored by Git.
# Local development only: where the storefront's server-side rendering reaches
# the API Worker started by `npm run dev:api`. Plain HTTP is accepted for
# localhost / 127.0.0.1 only. Production uses the `API` service binding
# (see cloudflare.config.ts) and ignores this value.
API_INTERNAL_ORIGIN=http://127.0.0.1:8787
