{
  "name": "hiobuy-procurement",
  "private": true,
  "version": "1.0.0",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vinext dev",
    "predev:api": "npm run db:migrate",
    "dev:api": "wrangler dev --port 8787 -c wrangler.jsonc",
    "build": "npm run build:web && npm run build:api",
    "build:web": "vinext build",
    "build:api": "wrangler deploy --dry-run --env production -c wrangler.jsonc --outdir dist-api",
    "start": "vite preview",
    "deploy:web": "vinext-cloudflare deploy",
    "deploy:api": "node scripts/wrangler-api.mjs deploy --env production",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply hiobuy-procurement --local -c wrangler.jsonc",
    "db:migrate:remote": "node scripts/wrangler-api.mjs d1 migrations apply hiobuy-procurement --remote --env production",
    "db:reset": "node scripts/reset-local-db.mjs",
    "typecheck": "cf workers types && vinext typegen && tsc -p tsconfig.json && tsc -p tsconfig.admin.json && tsc -p tsconfig.worker.json && tsc -p tsconfig.node.json",
    "cf-typegen:web": "cf workers types",
    "cf-typegen:api": "wrangler types -c wrangler.jsonc",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.129",
    "@better-auth/drizzle-adapter": "^1.7.7",
    "@cloudflare/ai-chat": "^0.12.1",
    "@cloudflare/voice": "^0.5.0",
    "@fontsource/inter": "^5.3.0",
    "@heroicons/react": "^2.2.0",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-select": "^2.3.7",
    "@tanstack/react-query": "^5.104.1",
    "@vinext/cloudflare": "^1.3.3",
    "agents": "^0.26.0",
    "ai": "^7.0.127",
    "better-auth": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "country-flag-icons": "^1.6.20",
    "dayjs": "^1.11.23",
    "drizzle-orm": "^0.45.3",
    "framer-motion": "^14.9.1",
    "hono": "^4.13.13",
    "js-cookie": "^3.0.8",
    "lucide-react": "^1.68.0",
    "next": "16.4.5",
    "next-intl": "4.14.9",
    "next-themes": "^0.4.6",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "react-photo-view": "^1.2.7",
    "react-router": "^8.4.0",
    "react-server-dom-webpack": "^19.3.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "stripe": "^23.0.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "vinext": "^1.4.3",
    "workers-ai-provider": "^4.0.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@babel/plugin-transform-runtime": "^8.1.2",
    "@cloudflare/vite-plugin": "^2.0.0-beta.v.11",
    "@cloudflare/workers-types": "^5.20261004.1",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^26.6.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitejs/plugin-rsc": "^0.5.38",
    "cf": "^1.0.0-beta.27",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.2",
    "vite-plugin-svgr": "^5.2.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.1.0",
    "wrangler": "^4.147.0"
  }
}
